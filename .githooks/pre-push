#!/usr/bin/env bash
# The slower gate: run the test suite before a push reaches CI. Coverage's
# 85% floor stays CI's job (it installs pytest-cov); this catches real test
# breaks fast. Bypass with `git push --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-push] pytest -q (mirrors CI's test job)"
uv run pytest -q || {
  echo "[pre-push] tests FAILED -- fix, or 'git push --no-verify' to bypass." >&2
  exit 1
}
echo "[pre-push] paper gate (scripts/check-paper.sh)"
scripts/check-paper.sh || exit 1
echo "[pre-push] OK"
