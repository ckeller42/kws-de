.venv/
__pycache__/
*.pyc
dist/
.pytest_cache/
.ruff_cache/
.superpowers/
.coverage
*.egg-info/
build/

# ML artifacts — recipe is versioned, bytes are not
data/
models/
*.npy
*.tflite
!tests/fixtures/**/*.tflite

# ESP-IDF firmware build
firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
firmware/managed_components/
firmware/dependencies.lock
firmware/test/*.o

# host parity harness: the pinned esp-nn clone plus the probe, real-clip
# models and vector headers tests/test_codegen_parity.py writes into a scratch
# tmp_path (GEN_DIR override, see firmware/test/Makefile) — build fixtures,
# not shipped firmware, except the wake and command inference committed as
# the firmware artefacts. *_infer_vectors.h (recordings-derived, ~400 KB) is
# deliberately NOT committed — see *_smoke_vectors.h for the committed,
# synthetic, model-free equivalent test_wake_smoke/test_command_smoke build
# against.
firmware/test/.esp-nn/
# compiled host-test binaries: every test_* in that directory that is not a
# source file (the sources are test_*.c, matched by the negation below).
firmware/test/test_*
!firmware/test/test_*.c
firmware/main/gen/conv_probe*
firmware/main/gen/*_infer.c
firmware/main/gen/*_infer.h
firmware/main/gen/*_infer_vectors.h
!firmware/main/gen/wake_infer.c
!firmware/main/gen/wake_infer.h
!firmware/main/gen/command_infer.c
!firmware/main/gen/command_infer.h

# local training environments + data (train/mww etc.)
train/**/.venv/
train/**/datasets/
train/**/*.wav
train/**/*.npy
docs/_build/
docs/sphinx/_build/
docs/distill-report.md
docs/distill-benchmark.json

# git worktrees (superpowers)
.worktrees/
